---
interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const SITE_NAME = 'The Group';
const DEFAULT_TITLE = 'The Group — Agência de Comunicação';
const DEFAULT_DESCRIPTION =
  'Aqui tem estratégia, criatividade e resultado. A The Group é uma agência de comunicação full-service em São Paulo, com alcance global pela rede WPI.';
const DEFAULT_IMAGE = '/images/og-image.jpg';

const {
  title,
  description = DEFAULT_DESCRIPTION,
  image = DEFAULT_IMAGE,
} = Astro.props;

const pageTitle = title ?? DEFAULT_TITLE;

// Absolute URLs for canonical + social embeds (resolved against the request origin).
const canonicalURL = new URL(Astro.url.pathname, Astro.url.origin);
const imageURL = new URL(image, Astro.url.origin);
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/images/TG-icon.svg" />

    <!-- Primary meta -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#030303" />
    <link rel="canonical" href={canonicalURL.href} />

    <!-- Open Graph (Facebook, LinkedIn, WhatsApp, etc.) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={imageURL.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL.href} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Figtree:wght@400;600&family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/modal-manager';
      import '../scripts/scroll-reveal';
      import '../scripts/gradient-follow';
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
