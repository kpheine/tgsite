---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ContatoFooter from '../components/ContatoFooter.astro';

// Astro serves this for any unmatched route. In SSR the status is set from the
// response below so crawlers and monitoring see a real 404, not a soft one.
Astro.response.status = 404;

const atalhos = [
  { href: '/#cases', label: 'Cases' },
  { href: '/sobre', label: 'Nossa história' },
  { href: '/wpi', label: 'Conexão global' },
  { href: '/canal-de-denuncias', label: 'Canal de denúncias' },
];
---
<Layout
  title="Página não encontrada | The Group"
  description="A página que você procura não existe ou foi movida."
>
  <Header />
  <main>
    <section class="erro">
      <div class="erro__inner" data-reveal-stagger>
        <p class="erro__code" data-reveal="up" aria-hidden="true">404</p>

        <h1 class="erro__title" data-reveal="up">
          <span class="erro__title-gradient">Aqui não tem</span> essa página.
        </h1>

        <p class="erro__lead" data-reveal="up">
          O link pode estar errado, ou a página pode ter mudado de endereço.
          Mas tem muita coisa boa no resto do site.
        </p>

        <a href="/" class="site-button site-button--gradient erro__cta" data-reveal="up">
          Voltar para o início
        </a>

        <nav class="erro__atalhos" aria-label="Atalhos" data-reveal="up">
          {atalhos.map((atalho) => <a href={atalho.href}>{atalho.label}</a>)}
        </nav>
      </div>
    </section>
  </main>
  <ContatoFooter />
</Layout>

<style>
  .erro {
    background-color: #030303;
    background-image: url('/images/degrade-pixels.png');
    background-size: auto;
    background-repeat: repeat-x;
    background-position: 0 center;
    background-blend-mode: hard-light;
    animation: bg-pan-x 240s linear infinite reverse;
    width: 100%;
    flex: 1;
    display: flex;
    /* Top-aligned on purpose: centring lets tall content overflow upward on
       short viewports and slide under the sticky header. */
    align-items: flex-start;
    /* Clears the 120px sticky header, which sits over the page content. */
    padding: 200px 165px 120px;
  }

  .erro__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 46rem;
  }

  .erro__code {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(4rem, 11vw, 9.5rem);
    line-height: 0.85;
    letter-spacing: 0.02em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.28);
    margin: 0;
  }

  .erro__title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(2.5rem, 5.6vw, 5.6rem);
    line-height: 0.95;
    color: #fff;
    margin: clamp(1rem, 2vw, 1.75rem) 0 0;
  }

  .erro__title-gradient {
    background: linear-gradient(
      -84.12deg,
      rgb(234, 14, 129) 5%,
      rgb(163, 67, 203) 83%,
      rgb(87, 112, 225) 93%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .erro__lead {
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    font-size: clamp(1rem, 1.35vw, 1.4rem);
    line-height: 1.5;
    color: #e9e9e9;
    margin: clamp(1.25rem, 2.5vw, 2rem) 0 0;
    max-width: 34ch;
  }

  .erro__cta {
    align-self: flex-start;
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    --site-button-padding: 1.05rem 2.4rem;
    --site-button-font-size: clamp(0.95rem, 1.15vw, 1.2rem);
  }

  .erro__atalhos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    margin-top: clamp(2.5rem, 4vw, 3.5rem);
    padding-top: clamp(1.25rem, 2vw, 1.75rem);
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    width: 100%;
  }

  .erro__atalhos a {
    position: relative;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.25rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #fff;
    text-decoration: none;
    opacity: 0.75;
    transition: opacity 0.15s ease;
  }

  .erro__atalhos a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 100%;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.28s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .erro__atalhos a:hover { opacity: 1; }
  .erro__atalhos a:hover::after { transform: scaleX(1); }

  @media (max-width: 1024px) {
    .erro { padding: 180px 5rem 5rem; }
  }

  @media (max-width: 768px) {
    .erro { padding: 9rem 1.5rem 4rem; }
    .erro__cta { align-self: stretch; }
    .erro__lead { max-width: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .erro { animation: none; }
    .erro__atalhos a::after { transition: none; }
  }
</style>
