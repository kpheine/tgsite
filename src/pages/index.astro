---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
import CasesSection from '../components/CasesSection.astro';
import HistoriaSection from '../components/HistoriaSection.astro';
import DiferenciaisSection from '../components/DiferenciaisSection.astro';
import ClientesSection from '../components/ClientesSection.astro';
import DepoimentosSection from '../components/DepoimentosSection.astro';
import PremiosSection from '../components/PremiosSection.astro';
import WpiSection from '../components/WpiSection.astro';
import ContatoFooter from '../components/ContatoFooter.astro';
---
<Layout
  title="The Group — Agência de Comunicação"
  description="Aqui tem estratégia, criatividade e resultado. A The Group é uma agência de comunicação full-service em São Paulo, com alcance global pela rede WPI."
>
  <Header />
  <main>
    <HeroSection />
    <CasesSection />
    <HistoriaSection />
    <DiferenciaisSection />
    <ClientesSection />
    <DepoimentosSection />
    <PremiosSection />
    <WpiSection />
  </main>
  <ContatoFooter />
</Layout>
