---
---
<section class="hero-section">
  <!-- Background video -->
  <div class="hero-bg" aria-hidden="true">
    <video
      class="hero-bg__video"
      data-hero-video
      autoplay
      muted
      loop
      playsinline
    >
      <source src="/videos/video-home-hero.webm" type="video/webm" />
      <source src="/videos/video-home-hero.mp4" type="video/mp4" />
    </video>
  </div>
  <div class="hero-overlay" aria-hidden="true"></div>

  <!-- Hero headline temporarily hidden — keep for later re-enable (typing animation lives in the commented <script> below)
  <h1
    class="hero-headline"
    aria-label="Aqui tem estratégia, criatividade, inteligência, análise, planejamento e solução"
  >
    <span class="hero-headline__prefix">AQUI TEM</span>
    <span class="hero-headline__typed" data-hero-typed-word>Estratégia</span><span
      class="hero-headline__cursor is-idle"
      data-hero-typing-cursor
      aria-hidden="true"
    >_</span>
  </h1>
  -->

  <!-- Unmute / mute toggle for the background video -->
  <button type="button" class="hero-sound" data-hero-sound aria-label="Ativar som do vídeo" aria-pressed="false">
    <svg class="hero-sound__icon hero-sound__icon--muted" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M11 5 6 9H2v6h4l5 4V5z" fill="currentColor" />
      <path d="m23 9-6 6M17 9l6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    </svg>
    <svg class="hero-sound__icon hero-sound__icon--on" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M11 5 6 9H2v6h4l5 4V5z" fill="currentColor" />
      <path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    </svg>
  </button>

  <!-- Bottom bar: social icons + address -->
  <div class="hero-footer" data-reveal="up">
    <div class="social-icons" aria-label="Redes sociais">
      <a href="https://www.linkedin.com/company/thegroupcomunicacao/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="social-item">
        <img src="/images/footer/social-blob.png" alt="" class="social-item__blob" aria-hidden="true" />
        <img src="/images/footer/linkedin-icon.svg" alt="LinkedIn" class="social-item__icon" />
      </a>
      <a href="https://www.youtube.com/@WPIThegroup" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="social-item">
        <img src="/images/footer/social-blob.png" alt="" class="social-item__blob" aria-hidden="true" />
        <img src="/images/footer/play-icon.svg" alt="YouTube" class="social-item__icon" />
      </a>
      <a href="https://www.instagram.com/thegroupcomunicacao/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="social-item">
        <img src="/images/insta-logo.png" alt="Instagram" class="social-item__combined" />
      </a>
    </div>

    <address class="hero-address">
      Av. Eng. Luis Carlos Berrini, 1700<br />
      16º andar, São Paulo – SP – Brasil
    </address>
  </div>

  <!-- Scroll indicator arrow -->
  <button class="scroll-arrow" aria-label="Rolar para baixo" onclick="document.getElementById('cases').scrollIntoView({behavior:'smooth'})">
    <img src="/images/hero-vector.svg" alt="" width="23" height="29" />
  </button>
</section>

<!--
  Hero headline typing animation. The headline <h1> above is currently commented out,
  so `typedWord`/`cursor` resolve to null and this safely no-ops. Re-enable the <h1>
  to bring the animation back — no changes needed here.
-->
<script>
  const typedWord = document.querySelector<HTMLElement>('[data-hero-typed-word]');
  const cursor = document.querySelector<HTMLElement>('[data-hero-typing-cursor]');
  const words = ['Estratégia', 'Criatividade', 'Inteligência', 'Análise', 'Planejamento', 'Solução'];
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (typedWord && cursor && !prefersReducedMotion) {
    let wordIndex = 0;
    let characterIndex = words[wordIndex].length;
    let isDeleting = true;

    const setIdle = (isIdle: boolean) => {
      cursor.classList.toggle('is-idle', isIdle);
    };

    const scheduleNextStep = (delay: number) => {
      window.setTimeout(typeNextCharacter, delay);
    };

    const typeNextCharacter = () => {
      const currentWord = words[wordIndex];
      setIdle(false);

      if (isDeleting) {
        characterIndex -= 1;
        typedWord.textContent = currentWord.slice(0, characterIndex);

        if (characterIndex === 0) {
          isDeleting = false;
          wordIndex = (wordIndex + 1) % words.length;
          scheduleNextStep(260);
          return;
        }

        scheduleNextStep(58);
        return;
      }

      const nextWord = words[wordIndex];
      characterIndex += 1;
      typedWord.textContent = nextWord.slice(0, characterIndex);

      if (characterIndex === nextWord.length) {
        setIdle(true);
        isDeleting = true;
        scheduleNextStep(3200);
        return;
      }

      scheduleNextStep(95);
    };

    window.setTimeout(typeNextCharacter, 1600);
  }
</script>

<script>
  // Background video starts muted (required for autoplay); this toggles sound on/off.
  const heroVideo = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const soundBtn = document.querySelector<HTMLButtonElement>('[data-hero-sound]');

  if (heroVideo && soundBtn) {
    soundBtn.addEventListener('click', () => {
      heroVideo.muted = !heroVideo.muted;
      // If the browser paused playback, make sure it resumes once unmuted.
      if (!heroVideo.muted) heroVideo.play().catch(() => {});

      soundBtn.classList.toggle('is-on', !heroVideo.muted);
      soundBtn.setAttribute('aria-pressed', String(!heroVideo.muted));
      soundBtn.setAttribute(
        'aria-label',
        heroVideo.muted ? 'Ativar som do vídeo' : 'Desativar som do vídeo'
      );
    });
  }
</script>

<style>
  .hero-section {
    position: relative;
    width: 100%;
    height: 100svh;
    min-height: 500px;
    overflow: hidden;
  }

  /* Background video */
  .hero-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-bg__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Darkening overlay so the headline stays legible */
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.2);
    pointer-events: none;
  }

  .hero-headline {
    position: absolute;
    top: 44.9%;
    left: 50%;
    transform: translateX(-50%);
    width: 83.9%;
    color: #fff;
    font-family: 'Bebas Neue', Impact, sans-serif;
    font-size: clamp(4rem, 8.6vw, 8.8rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 0.86;
    pointer-events: none;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .hero-headline__prefix {
    background: linear-gradient(100deg, #3157d6 0%, #23d6ec 28%, #ec148f 55%, #3157d6 82%, #23d6ec 100%);
    background-size: 240% 100%;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: hero-gradient-cycle 30s ease-in-out infinite;
  }

  .hero-headline__typed,
  .hero-headline__cursor {
    color: #fff;
  }

  .hero-headline__cursor {
    opacity: 1;
  }

  .hero-headline__cursor.is-idle {
    animation: hero-cursor-blink 1.2s steps(1, end) infinite;
  }

  @keyframes hero-cursor-blink {
    0%, 45% {
      opacity: 1;
    }

    46%, 100% {
      opacity: 0;
    }
  }

  @keyframes hero-gradient-cycle {
    0%, 100% {
      background-position: 0% 50%;
    }

    50% {
      background-position: 100% 50%;
    }
  }

  /* Bottom bar */
  .hero-footer {
    position: absolute;
    bottom: 4%;
    left: 3%;
    right: 3%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .social-icons {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .social-item {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    transition: transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1), filter 0.25s ease;
  }

  .social-item:hover {
    transform: translateY(-3px) scale(1.1);
    filter: brightness(1.12);
  }

  @media (prefers-reduced-motion: reduce) {
    .social-item {
      transition: none;
    }
    .social-item:hover {
      transform: none;
    }
  }

  .social-item__blob {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .social-item__icon {
    position: relative;
    width: 55%;
    height: 55%;
    object-fit: contain;
  }

  /* Instagram icon ships with the blob already baked in, so it fills the
     whole item to match the footprint of the other icons' blobs */
  .social-item__combined {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .hero-address {
    font-family: 'Inter', sans-serif;
    font-style: normal;
    font-size: 1.09rem; /* ~17.4px */
    line-height: 1.4;
    color: #fff;
    text-align: right;
  }

  /* Scroll-down arrow — bottom center */
  .scroll-arrow {
    position: absolute;
    bottom: 4%;
    left: 50%;
    transform: translateX(-50%) rotate(180deg);
    opacity: 0.6;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }

  .scroll-arrow:hover {
    opacity: 1;
  }

  /* Sound toggle — bottom-right, above the address */
  .hero-sound {
    position: absolute;
    bottom: 13%;
    right: 3%;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: #fff;
    cursor: pointer;
    transition: transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1), background 0.25s ease;
  }

  .hero-sound:hover {
    transform: scale(1.08);
    background: rgba(0, 0, 0, 0.55);
  }

  .hero-sound__icon {
    position: absolute;
    width: 22px;
    height: 22px;
  }

  /* Show the muted icon by default, the sound-on icon once unmuted */
  .hero-sound__icon--on {
    display: none;
  }

  .hero-sound.is-on .hero-sound__icon--muted {
    display: none;
  }

  .hero-sound.is-on .hero-sound__icon--on {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-sound {
      transition: none;
    }
    .hero-sound:hover {
      transform: none;
    }
  }

  @media (max-width: 768px) {
    .hero-headline {
      font-size: clamp(3.1rem, 8.7vw, 5rem);
    }

    .hero-address {
      font-size: 0.85rem;
    }
  }

  @media (max-width: 480px) {
    .hero-headline {
      top: 42%;
      left: 50%;
      width: 88%;
      font-size: clamp(2.25rem, 15vw, 4.4rem);
      white-space: normal;
    }

    .hero-address {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-headline__prefix,
    .hero-headline__cursor.is-idle {
      animation: none;
    }
  }
</style>
